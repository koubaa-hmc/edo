import QmlProject

Project {
    mainFile: "qml/EdoClientContent/App.qml"

    QmlFiles {
        directory: "qml/EdoClientContent"
    }

    QmlFiles {
        directory: "qml/EdoClient"
    }

    Files {
        filter: "*.conf"
        files: ["qml/qtquickcontrols2.conf"]
    }

    Files {
        filter: "qmldir"
        directory: "qml"
    }

    Environment {
        QT_QUICK_CONTROLS_CONF: "qml/qtquickcontrols2.conf"
    }

    qt6Project: true
    importPaths: [ "." ]

    mainUiFile: "qml/EdoClientContent/SidebarMenu.ui.qml"
}
